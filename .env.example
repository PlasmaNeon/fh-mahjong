# Copy to .env and adjust, then: docker compose --profile full up
#
# The RL policy server needs a real model checkpoint (.pt). The repo only ships
# the manifest, which references training-box paths, so point these at a host
# directory that contains your checkpoint file.

# Host directory mounted read-only into the policy container at /checkpoints.
RL_CHECKPOINT_DIR=./ai/checkpoints

# Checkpoint filename inside RL_CHECKPOINT_DIR (served via --checkpoint).
RL_CHECKPOINT_FILE=model.pt

# Browser session security. Production images set APP_ENV=production, which
# enables the Secure __Host-fh_session cookie. Add exact comma-separated origins
# only when the frontend and API are separate same-site origins.
FRONTEND_ORIGINS=http://localhost:3000

# Opponent-hand redaction is fail-closed and stays ON everywhere by default
# (including docker-compose and any deploy). The ONLY way to get the local
# all-hands debug god-view is to run the backend with MAHJONG_DEV_REVEAL_HANDS=1
# explicitly — use `make dev`. Do NOT add that var to this file or to any
# container/compose config: anything that could be deployed must stay redacted.
